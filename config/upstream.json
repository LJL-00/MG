{
  "threads": 8,
  "memory_gb": 32,
  "expected_main_isolates": 56,
  "reference_fasta": "",
  "reference_for_snippy": "",
  "adapters_fasta": "",
  "busco_dataset_path": "",
  "busco_download_path": "",
  "spades_kmers": [
    21,
    33,
    55,
    77,
    99
  ],
  "tools": {
    "FastQC": {
      "command": [
        "fastqc"
      ],
      "version_args": [
        "--version"
      ],
      "version_regex": "FastQC\\s+v?([\\d.]+)",
      "required_version": "0.12.1"
    },
    "MultiQC": {
      "command": [
        "multiqc"
      ],
      "version_args": [
        "--version"
      ],
      "version_regex": "version\\s+([\\d.]+)",
      "required_version": "1.33"
    },
    "Trimmomatic": {
      "command": [
        "trimmomatic"
      ],
      "version_args": [
        "-version"
      ],
      "version_regex": "(\\d+\\.\\d+(?:\\.\\d+)?)",
      "required_version": "0.40"
    },
    "SPAdes": {
      "command": [
        "spades.py"
      ],
      "version_args": [
        "--version"
      ],
      "version_regex": "SPAdes(?: genome assembler)?\\s+v?([\\d.]+)",
      "required_version": "4.2.0"
    },
    "QUAST": {
      "command": [
        "quast.py"
      ],
      "version_args": [
        "--version"
      ],
      "version_regex": "QUAST\\s+v?([\\d.]+)",
      "required_version": "5.3.0"
    },
    "BUSCO": {
      "command": [
        "busco"
      ],
      "version_args": [
        "--version"
      ],
      "version_regex": "BUSCO\\s+v?([\\d.]+)",
      "required_version": "6.0.0"
    },
    "Snippy": {
      "command": [
        "snippy"
      ],
      "version_args": [
        "--version"
      ],
      "version_regex": "snippy\\s+v?([\\d.]+)",
      "required_version": "4.6.0",
      "preflight_args": [
        "--check"
      ]
    },
    "IQ-TREE": {
      "command": [
        "iqtree3"
      ],
      "version_args": [
        "--version"
      ],
      "version_regex": "version\\s+([\\d.]+)",
      "required_version": "3.1.1"
    },
    "FastANI": {
      "command": [
        "fastANI"
      ],
      "version_args": [
        "--version"
      ],
      "version_regex": "version\\s*:?\\s*([\\d.]+)",
      "required_version": "1.34"
    },
    "STRUCTURE": {
      "command": [
        "structure"
      ],
      "version_args": [
        "-h"
      ],
      "version_regex": "version\\s+([\\d.]+)",
      "version_nonzero_ok": true,
      "required_version": "2.3.4"
    },
    "Bowtie2": {
      "command": [
        "bowtie2"
      ],
      "version_args": [
        "--version"
      ],
      "version_regex": "version\\s+([\\d.]+)",
      "required_version": "2.5.4"
    },
    "SAMtools": {
      "command": [
        "samtools"
      ],
      "version_args": [
        "--version"
      ],
      "version_regex": "samtools\\s+([\\d.]+)",
      "required_version": "1.23.1"
    },
    "Bowtie2-build": {
      "command": [
        "bowtie2-build"
      ],
      "version_args": [
        "--version"
      ],
      "version_regex": "version\\s+([\\d.]+)",
      "required_version": "2.5.4"
    },
    "BLASTP": {
      "command": [
        "blastp"
      ],
      "version_args": [
        "-version"
      ],
      "version_regex": "blastp:\\s*([\\d.]+)",
      "required_version": "2.17.0"
    },
    "Makeblastdb": {
      "command": [
        "makeblastdb"
      ],
      "version_args": [
        "-version"
      ],
      "version_regex": "makeblastdb:\\s*([\\d.]+)",
      "required_version": "2.17.0"
    }
  },
  "snippy_dependencies": {
    "minimum_BCFtools": "1.7",
    "note": "Use the Snippy environment and run snippy --check before analysis."
  }
}
